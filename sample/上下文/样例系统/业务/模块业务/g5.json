          "concepts": [
            "服务协议",
            "服务记录",
            "凭据"
          ],
          "fns": [
            "f-3"
          ]
        },
        {
          "by": "财务",
          "text": "把还没申报的服务记录写成申报行，报给政府。",
          "concepts": [
            "申报行"
          ],
          "fns": [
            "f-5"
          ]
        },
        {
          "by": "财务",
          "text": "政府审核完，记下每一行申报行是通过还是被退回。",
          "concepts": [
            "申报行"
          ],
          "fns": [
            "f-8"
          ]
        },
        {
          "by": "财务",
          "text": "审核通过的一行，从老人名下的基金账户扣款。扣款在「参与者档案与她名下的钱」里办。",
          "concepts": [
            "基金账户"
          ]
        },
        {
          "by": "财务",
          "text": "月底把这个月的服务记录和照护管理记录汇总成月结单，发给老人。",
          "concepts": [
            "月结单",
            "月结单明细"
          ],
          "fns": [
            "f-6"
          ]
        }
      ]
    },
    {
