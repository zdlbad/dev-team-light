{
  "topic": "g5",
  "title": "服务发生与申报",
  "summary": "注册服务方把做了的每一次服务记成服务记录，再照服务记录向政府申报。",
  "tours": [
    {
      "title": "外部服务方做的服务：从发票到申报、月结单",
      "note": "请外部服务方做的服务，从发票登记进来，核对后记成服务记录，写成申报行报给政府，月底列进月结单。",
      "steps": [
        {
          "by": "照护伙伴",
          "text": "外部服务方开来发票，把发票上的每一行登记成发票行。",
          "concepts": [
            "发票行"
          ],
          "fns": [
            "f-2"
