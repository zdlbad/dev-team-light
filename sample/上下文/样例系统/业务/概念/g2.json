{
  "topic": "g2",
  "title": "参与者档案与她名下的钱",
  "summary": "这一块管两件事：注册服务方替老人留的档案，和政府开在她名下、替她保管的钱。评估批了什么、她跟哪家签了协议、共付比例多少，都记在档案上；后面每一笔钱怎么花、怎么报都照着来。",
  "concepts": [
    {
      "id": "file",
      "title": "参与者档案",
      "by": [
        "注册服务方"
      ],
      "order": 1,
      "fields": [
        "My Aged Care 编号",
        "共付比例",
        "她在哪一段"
      ],
      "definition": "注册服务方从老人第一次联系起替她留的一份记录：批了哪一级、哪条路径、允许的服务类型、共付比例、她在哪一段。",
      "source": "手册 v4.4 §3 Participant；§6.6 行 562–568"
    },
    {
      "id": "level",
      "title": "批到的分级和路径",
      "order": 1,
      "fields": [
        "分级",
        "路径"
      ],
      "definition": "决定通知书上批给她的那一级和那条路径。建档时照通知书记进档案，以后每季分多少钱照这一级算。",
      "source": "§6.6 行 562–568"
    },
    {
      "id": "signed",
      "title": "签了的服务协议",
      "order": 2,
      "fields": [
        "签的协议",
        "签约日期"
      ],
      "definition": "档案上记着的一笔：她跟注册服务方签的是哪一份服务协议、哪天签的。",
      "source": "§7.1 行 676"
    },
    {
      "id": "fund",
      "title": "她名下的基金",
      "by": [
        "Services Australia"
      ],
      "order": 2,
      "definition": "政府开在老人名下、替她保管的钱。持续服务按分级每季一笔；批了辅助技术、家居改造、复健、临终的各多一笔。",
      "source": "§9.2 行 1290"
    },
    {
      "id": "acct",
      "title": "基金账户",
      "order": 3,
      "fields": [
        "服务类型"
      ],
      "definition": "一笔基金一个账户，只能买她批了的服务类型；申报行按她的编号从对应的账户扣。",
      "source": "§9.2 行 1290；申报格式 v1.14 第 4 节第 9 项"
    },
    {
      "id": "bal",
      "title": "余额",
      "order": 3,
      "definition": "基金账户里还剩多少钱（澳元）。分到资金时记上，每扣一笔就减一笔。",
      "source": "§9.2 行 1290"
    }
  ],
