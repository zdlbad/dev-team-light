{
  "topic": "g5",
  "title": "服务发生与申报",
  "summary": "这一块管做了的服务怎么留下记录、怎么报给政府：每一次服务记成一条服务记录，外面开来的发票先登记、核对；照服务记录写申报行，月底汇总成月结单发给老人。",
  "concepts": [
    {
      "id": "inv",
      "title": "发票行",
      "by": [
        "照护伙伴"
      ],
      "order": 1,
      "fields": [
        "发票号",
        "服务项",
        "数量",
        "金额"
      ],
      "definition": "外部服务方开来的发票上的一行，对着一次服务。先登记下来，核对无误才记成服务记录。",
      "source": "手册 v4.4 §10.3 行 1512"
    },
    {
      "id": "rec",
      "title": "服务记录",
      "by": [
        "照护伙伴"
      ],
      "order": 1,
      "fields": [
        "日期",
        "服务项",
        "数量",
        "金额"
      ],
      "definition": "做了一次服务记一条：哪天、哪项服务、做了多少、多少钱。申报、扣款和月结单都从它开始。",
      "source": "手册 v4.4 §10.1 行 1466"
    },
    {
      "id": "proof",
      "title": "凭据",
      "order": 2,
      "fields": [
        "凭据的种类",
        "对着哪一行发票行或哪一张收据"
      ],
      "definition": "一条服务记录是照什么记下的：发票上的哪一行，或者老人交来的哪一张收据。自己的工作者做的服务没有凭据。",
      "source": "手册 v4.4 §10.3 行 1520"
    },
    {
      "id": "cm",
      "title": "照护管理记录",
      "by": [
        "照护伙伴"
      ],
      "order": 2,
      "fields": [
        "日期",
        "做了多久",
        "做了什么"
      ],
      "definition": "照护伙伴替老人做一次照护管理记一条：哪天、做了多久、做了什么。",
      "source": "手册 v4.4 §8.4 行 960"
    },
    {
      "id": "claim",
      "title": "申报行",
      "by": [
        "财务"
      ],
      "order": 1,
      "fields": [
        "老人的编号",
        "服务类型",
        "申报的金额"
      ],
      "definition": "向政府申报的一行，对着一条服务记录。报上去以后政府审核，通过了才从老人名下的基金账户扣款，被退回的改了重新报。",
      "source": "申报格式 v1.14 第 4 节"
    },
    {
      "id": "stmt",
      "title": "月结单",
      "by": [
        "财务"
      ],
      "order": 2,
      "fields": [
        "月份",
        "合计"
      ],
      "definition": "每月给老人的一份清单，列着这个月的服务和花的钱。出了以后留着，老人照它付自己该付的钱。",
      "source": "手册 v4.4 §11.2 行 1630"
    },
    {
      "id": "line",
      "title": "月结单明细",
      "order": 3,
      "fields": [
        "对着哪一条记录",
        "金额"
      ],
      "definition": "月结单上的一行：这个月的一条服务记录，或者一条照护管理记录，带着金额。",
      "source": "手册 v4.4 §11.2 行 1634"
    }
  ],
