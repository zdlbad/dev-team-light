{
  "file": "src/fund/fund-account.ts",
  "blocks": [
    {
      "name": "扣",
      "params": [
        "金额",
        "服务类型"
      ],
      "asks": [
        {
          "id": "a-1",
          "q": "金额是 0 的时候，算不算扣了一笔？",
          "lean": "不算：直接返回，不发事件",
          "options": [
            "不算：直接返回，不发事件",
            "算：照常走，发 已扣款"
          ]
        }
      ],
      "steps": [
        "服务类型 不在她批了的范围内 → <span class=\"g\">抛 服务类型不许</span>",
        "余额 < 金额 → <span class=\"g\">抛 余额不足</span>",
        "<span class=\"w\">余额 ← 余额 − 金额</span>",
        "余额 是 0 → <span class=\"w\">状态 ← 已用完</span>",
        "返回 <span class=\"e\">事件 已扣款(类型, 金额, 余额)</span>"
      ],
      "tests": [
        {
          "name": "守：服务类型在批了的范围内",
          "given": "账户只许 持续服务",
          "when": "扣(金额, 辅助技术)",
          "then": "抛 服务类型不许；余额没动"
        },
        {
          "name": "守：余额够",
          "given": "余额 100",
          "when": "扣(150, 持续服务)",
          "then": "抛 余额不足；余额没动"
        },
        {
          "name": "发：已扣款",
          "given": "余额 100",
          "when": "扣(40, 持续服务)",
          "then": "余额 60；状态 可用；返回事件 已扣款"
        },
        {
          "name": "扣到零",
          "given": "余额 100",
          "when": "扣(100, 持续服务)",
          "then": "余额 0；状态 已用完"
        }
      ]
    }
  ]
}
