{
  "file": "01-老人注册",
  "title": "老人注册：从通知书到签协议、分到资金",
  "summary": "一位举例的老人从头一次联系到资金到位：她 12/01/2026 头一次联系注册服务方，照护伙伴替她申请评估；02/03 评估批了，她拿到决定通知书和支持计划，进了政府的排队；05/03 把通知书交来，照护伙伴建档；04/05 还在排队就签了服务协议；01/07 卫生部来信分到全额资金。日子都是举的例子。",
  "parties": [
    {
      "id": "old",
      "title": "老人",
      "sub": "和她登记的支持人"
    },
    {
      "id": "rp",
      "title": "注册服务方",
      "sub": "照护伙伴替她办"
    },
    {
      "id": "gov",
      "title": "政府",
      "sub": "评估代表、卫生部"
    }
  ],
  "steps": [
    {
      "id": "1",
      "from": "old",
      "to": "rp",
      "title": "考虑申请居家养老，头一次联系",
      "date": "12/01/2026"
    },
    {
      "id": "2",
      "from": "rp",
      "to": "gov",
      "title": "替她在 My Aged Care 申请评估",
      "date": "14/01/2026",
      "source": "§6.1 行 506、§6.3 行 513–514"
    },
    {
      "id": "3",
      "from": "gov",
      "to": "old",
      "title": "评估批了持续服务，发决定通知书和支持计划；她进政府的排队",
      "date": "02/03/2026",
      "data": [
        "决定通知书",
        "支持计划"
      ],
      "source": "§6.5 行 549–556、§6.6 行 562–568",
      "note": "通知书写她批了哪一级、哪条路径；支持计划写她批了哪些服务类型。从这天起她在政府那边按四档之一排队等资金。"
    },
    {
      "id": "4",
      "from": "old",
      "to": "rp",
      "title": "把决定通知书交给注册服务方",
      "date": "05/03/2026",
      "data": [
        "决定通知书"
      ]
    },
    {
      "id": "5",
      "from": "rp",
      "to": "rp",
      "title": "照护伙伴建她的参与者档案，记下通知书上的分级与路径",
      "date": "05/03/2026",
      "data": [
        "参与者档案"
      ],
      "note": "档案是以后一切的底：分级、路径、允许的服务类型、共付比例都从通知书和支持计划抄进来。",
      "rules": [
        {
          "id": "r-1",
          "text": "档案上的分级、路径照通知书抄，和通知书不一样的不能建",
          "source": "§6.6 行 562–568",
          "status": "待定",
          "lean": "照通知书为准，不让手改",
          "options": [
            "照通知书为准，不让手改",
            "允许手改，记下为什么"
          ]
        },
        {
          "id": "r-2",
          "text": "一位老人只有一份档案，按 My Aged Care 编号认",
          "source": "§3 Participant",
          "status": "定了"
        }
      ],
      "asks": [
        {
          "id": "a-1",
          "q": "通知书还没交来、只是口头说批了，能先建档吗？",
          "lean": "能，档案标「待核」，通知书到了再核",
          "options": [
            "能，标待核",
            "不能，等通知书"
          ]
        }
      ]
    },
    {
      "id": "6",
      "from": "old",
      "to": "rp",
      "title": "还在排队就签了正式的服务协议",
      "date": "04/05/2026",
      "data": [
        "服务协议"
      ],
      "due": "签后 14 天内、开始服务之前她还能退出",
      "source": "§7.2.1 行 710",
      "asks": [
        {
          "id": "a-2",
          "q": "退出期内她退出了，协议怎么记？",
          "answer": "协议记作废、留着不删，档案回到排队那一段",
          "answeredAt": "2026-10-31T02:00:00.000Z"
        }
      ]
    },
    {
      "id": "7",
      "from": "gov",
      "to": "old",
      "title": "卫生部来信：她分到了全额资金",
      "date": "01/07/2026",
      "data": [
        "分资金的信"
      ],
      "source": "§6.8 行 592、§6.8.1.1 行 613–615"
    },
    {
      "id": "8",
      "from": "rp",
      "to": "rp",
      "title": "照护伙伴记下分到资金那天、分到的是全额",
      "date": "01/07/2026",
      "due": "最晚 26/08/2026 开始服务",
      "source": "§6.9 行 625",
      "note": "从分到资金那天起 56 天内要开始服务，不然资金收回、重新排队；申请延期到 84 天。"
    }
  ]
